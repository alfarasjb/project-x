{
	"name": "project-x",
	"version": "0.0.0",
	"private": true,
	"description": "Architectural Co-Pilot — bidirectional architecture graph with MCP-driven drift detection",
	"type": "module",
	"packageManager": "pnpm@10.12.4",
	"engines": {
		"node": ">=20.11"
	},
	"scripts": {
		"dev": "concurrently -n web,server,trigger -c blue,green,magenta \"pnpm dev:web\" \"pnpm dev:server\" \"pnpm dev:trigger\"",
		"dev:web": "vite",
		"dev:server": "tsx watch --tsconfig tsconfig.server.json server/index.ts",
		"dev:trigger": "pnpm exec trigger dev --profile personal",
		"mcp": "tsx --tsconfig tsconfig.server.json server/mcp/index.ts",
		"eval:ai-review": "tsx --tsconfig tsconfig.server.json server/evals/ai-review/run.ts",
		"similarity:check": "tsx --tsconfig tsconfig.server.json server/evals/similarity/check.ts",
		"build": "vite build",
		"build:web": "vite build",
		"start": "tsx --tsconfig tsconfig.server.json server/index.ts",
		"routes:generate": "tsr generate",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx --tsconfig tsconfig.server.json server/db/seed.ts",
		"db:studio": "drizzle-kit studio",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"eslint --fix --no-warn-ignored",
			"prettier --write"
		],
		"*.{js,mjs,cjs,json,css,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.98.0",
		"@better-auth/infra": "^0.2.8",
		"@fastify/cors": "^11.2.0",
		"@fastify/static": "^9.1.3",
		"@fastify/websocket": "^11.2.0",
		"@langfuse/client": "^5.3.0",
		"@langfuse/otel": "^5.3.0",
		"@langfuse/tracing": "^5.3.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@opentelemetry/sdk-node": "^0.218.0",
		"@tanstack/react-query": "^5.100.11",
		"@tanstack/react-router": "^1.170.4",
		"@trigger.dev/sdk": "4.4.6",
		"@xyflow/react": "^12.10.2",
		"better-auth": "^1.6.11",
		"chokidar": "^5.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.8.5",
		"lucide-react": "^1.16.0",
		"postgres": "^3.4.9",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tar": "^7.5.15",
		"ts-morph": "^28.0.0",
		"tsx": "^4.22.3",
		"zod": "^4.4.3",
		"zustand": "^5.0.13"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/react-query-devtools": "^5.100.11",
		"@tanstack/react-router-devtools": "^1.167.0",
		"@tanstack/router-cli": "^1.167.9",
		"@tanstack/router-plugin": "^1.168.6",
		"@trigger.dev/build": "4.4.6",
		"@types/node": "^25.9.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"concurrently": "^9.2.1",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"lint-staged": "^17.0.5",
		"prettier": "^3.8.3",
		"tailwindcss": "^4.3.0",
		"trigger.dev": "^4.4.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"vite": "^8.0.13"
	}
}
